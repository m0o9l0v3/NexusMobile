{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdminDatabase": "Host=localhost;Port=5432;Database=nexus_admin;Username=nexus;Password=nexus_password"
  },
  "AdminAuth": {
    "Username": "admin",
    "Password": "AdminPassword123!",
    "Issuer": "Nexus.Admin",
    "Audience": "Nexus.AdminPortal",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "TokenExpiresMinutes": 480,
    "VisitorTokenExpiresMinutes": 60,
    "Role": "Owner"
  },
  "Portal": {
    "ParticipantBaseUrl": "https://example.local"
  },
  "OneTimeCode": {
    "HashKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "CodeBytesLength": 32
  },
  "QrIssue": {
    "HashKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "TokenBytesLength": 32,
    "PublicBaseUrl": "https://example.local"
  },
  "AuditLog": {
    "HashKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
  },
  "Cors": {
    "Origins": ["http://localhost:5173"]
  }
}
