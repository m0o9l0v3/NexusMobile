// Nexus アプリ（Debug）のビルド設定。

// 参加者向け API の基点 URL（M1-3）。空なら Map・探すは「未接続」のまま起動する。
// xcconfig は `//` から行末をコメントとして扱うため、URL は https:/$()/nexus.example のように `//` を分けて書く。
// 秘密情報は置かない。
NEXUS_API_BASE_URL =

// 手元の接続先（ローカル・隔離環境）は Git に含めない Local.xcconfig に書く（Local.xcconfig.example を参照）。
#include? "Local.xcconfig"
