{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdminDatabase": "Host=localhost;Port=5432;Database=nexus_admin;Username=nexus;Password=nexus_password"
  },
