      "columns": {
        "category": "区分",
        "source_id": "コード",
        "display_name": "名称",
        "status": "状態"
      },
      "row_filter": { "column": "category", "equals": "建物" },
      "required_values": ["source_id", "display_name"]
    },
    "indoor_mb_1f": {
      "kind": "inline",
