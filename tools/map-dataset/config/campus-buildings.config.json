  "indoor_transforms": [],
  "publish_readiness": {
    "blockers": [
      {
        "code": "building_geometry_unmeasured",
        "description": "原本 metadata が publishability=draft_only。建物Polygonの status は unmeasured / provisional / needs_review / confirmed が混在し、航空写真と基盤地図情報からの仮作成を含む。実測確定は #16 の責務。",
        "owner": "#16"
      },
      {
        "code": "display_names_unconfirmed",
        "description": "ab / amh / dh / lbh の表示名が原本間で不一致。E1-1 C-012 の学校公式表記確認が未了のため name を出力していない。",
        "owner": "E1-1 C-012"
      },
      {
        "code": "floors_not_registered",
        "description": "公開対象フロアと canonical SVG が未確定のため nexus.floors が空。屋内Featureを持つ payload は publish できない。",
        "owner": "#36"
      },
      {
        "code": "floor_local_coordinates_missing",
        "description": "どの原本にも floor-local 座標（x_m, y_m）列が存在しない。廊下長（校内マップ_実地調査データv1_3_0.xlsx::廊下データ）は材料であってアンカーの代替にはならない。",
        "owner": "#36"
      },
      {
        "code": "indoor_anchors_missing",
        "description": "E1-5 のアンカー入力契約（role / floor-local座標 / measurement_method / reported_accuracy_m / approved_by 等）を満たす記録が原本に存在しない。Nexus GPS実測記録 20260719.xlsx の建物シートは境界点IDのGPS座標のみで、対応するfloor-local座標・測定方法・精度・承認記録がない。仮値は作らない。",
        "owner": "#36"
      },
      {
        "code": "formal_entrance_connections_missing",
        "description": "屋外直結12棟の入口位置は map-data/normalized/entrances.csv に実測根拠つきで登録済み。ただし floor_id / outside_node_id / inside_node_id / is_primary が未確定のため formal_entrance を生成できない。仮の接続値は作らない。",
        "owner": "#36 / #39"
      },
      {
        "code": "route_graph_missing",
        "description": "屋内ノード・屋外ノード・歩行経路の canonical データが未作成。outdoor_node / walking_path / indoor_node は #16 と #39 の成果物。",
        "owner": "#16 / #39"
      }
    ]
  }
