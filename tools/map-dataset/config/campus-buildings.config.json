{
  "config_version": "1.0.0",
  "dataset_name": "nexus-campus-buildings",
  "description": "実地調査原本（QGIS由来 canonical GeoJSON + 校内マップ実地調査Excel）から、E1-4 スキーマに適合する建物Polygonだけを決定的に再生成するための対応設定。正式入口の位置は map-data/normalized/entrances.csv に整理済みだが、屋内ノード・経路・フロア・入口接続は未確定のため対象外（publish_readiness.blockers を参照）。原本は読み取りのみで変更しない。",
  "sources": {
    "canonical_geojson": {
      "kind": "geojson",
      "path": "確定版geojson/nexus_campus_canonical_20260724.geojson",
      "source_id_property": "id"
    },
    "id_master": {
      "kind": "excel",
      "path": "実地調査/校内マップ_実地調査データv1_3_0.xlsx",
      "sheet": "IDマスター",
      "header_row": 1,
      "columns": {
        "category": "カテゴリ",
        "source_id": "ID/コード",
        "display_name": "名称",
        "status": "ステータス"
      },
      "row_filter": { "column": "category", "equals": "建物" },
      "required_values": ["source_id", "display_name"]
    }
  },
  "building_registry": {
    "source": "id_master",
    "id_column": "source_id",
    "name_column": "display_name"
  },
  "reserved_ids": [],
  "floors": [],
